    "argon2": "0.45.1",
    "fastify": "5.6.0",
    "fflate": "0.8.2",
    "pg": "8.16.3",
    "quickjs-emscripten": "0.31.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
