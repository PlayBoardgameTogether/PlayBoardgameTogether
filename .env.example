NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgresql://boardgame:boardgame@127.0.0.1:5434/boardgame
TEST_DATABASE_URL=postgresql://boardgame:boardgame@127.0.0.1:5434/boardgame_test
WEB_ORIGIN=http://127.0.0.1:5173
ENABLE_DEV_LAB=true
VITE_ENABLE_DEV_LAB=true
VITE_API_BASE=/api/v1
LOG_LEVEL=info
COOKIE_SECURE=false
SESSION_TTL_MS=604800000
INVITE_TTL_MS=86400000
MAX_OPEN_ROOMS_PER_ACCOUNT=1
LOGIN_IP_FAILURES=10
LOGIN_USER_FAILURES=5
LOGIN_WINDOW_MS=600000
PRESENCE_GRACE_MS=10000
AI_GLOBAL_CONCURRENCY=4
AI_DECISION_TIMEOUT_MS=2000
AI_LEASE_MS=15000
AI_SCAN_INTERVAL_MS=5000
AI_MAX_ATTEMPTS=2

# Registration email verification. Unconfigured SMTP prevents new registrations.
# Existing accounts can still log in. Keep the password in private server config.
# SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER=sender@example.com
# SMTP_PASSWORD=configure-in-private-server-environment
# SMTP_FROM=sender@example.com
