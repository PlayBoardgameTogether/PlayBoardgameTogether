{
  "name": "@boardgame/splendor",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./tutorial": {
      "production": "./dist/client/tutorial.js",
      "default": "./src/client/tutorial.ts"
    },
    "./rules": {
      "production": "./dist/shared/rules.js",
      "default": "./src/shared/rules.ts"
    },
    "./shared": {
      "production": "./dist/shared/index.js",
      "default": "./src/shared/index.ts"
    },
    "./server": {
      "production": "./dist/server/index.js",
      "default": "./src/server/index.ts"
    },
    "./client": {
      "production": "./dist/client/index.js",
      "default": "./src/client/index.tsx"
    },
    "./assets": {
      "production": "./dist/shared/assets.js",
      "default": "./src/shared/assets.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node build.mjs"
  },
  "dependencies": {
    "@boardgame/game-sdk": "workspace:*",
    "react": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2"
  }
}
